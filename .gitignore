# ============================================================
# quant-harness .gitignore
# ============================================================

# ---------- Python 编译缓存 ----------
__pycache__/
# 覆盖 *.pyc / *.pyo / *.pyd
*.py[cod]
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 虚拟环境 ----------
# 本地 venv 含平台相关的二进制, 换机器/换系统都无法复用, 绝不入库
.venv-quant/
.venv/
venv/
env/

# ---------- 环境变量与密钥(极其重要) ----------
# 内含 DEEPSEEK_API_KEY 等真实密钥, 一旦入库等于泄露
.env
.env.*
# 例外: 允许提交不含真实 Key 的模板
!.env.example

# ---------- 运行期临时文件 ----------
# matplotlib 字体缓存(默认目录不可写时脚本自动降级到这里)
.mplconfig/
# 脚本间传子进程输出用的临时目录(本环境禁止匿名管道, 故用文件中转)
.tmp/

# ---------- 日志 ----------
logs/
*.log

# ---------- 本地数据库(体积大 + 可由 data_center.py 重建) ----------
data/*.db
# SQLite WAL 模式的两个伴随文件, 只忽略 *.db 会漏掉它们
data/*.db-wal
data/*.db-shm

# ---------- 选股池中间产物(由 market_screener / news_agent 重新生成) ----------
config/*.json

# ---------- 生成的图表与输出 ----------
output/

# ---------- IDE / 编辑器 ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini
